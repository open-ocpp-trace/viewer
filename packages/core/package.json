{
  "name": "@open-ocpp-trace/viewer-core",
  "version": "0.0.0",
  "description": "Framework-neutral model of the Open OCPP Trace viewer.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-ocpp-trace/viewer.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@open-ocpp-trace/viewer-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "pack": "vp pack",
    "prepublishOnly": "echo 'Publish the tarball from scripts/pack-release.sh, not this directory.' >&2; exit 1"
  },
  "dependencies": {
    "@open-ocpp-trace/core": "0.1.0"
  },
  "devDependencies": {
    "@open-ocpp-trace/jsonl": "0.1.0"
  }
}
